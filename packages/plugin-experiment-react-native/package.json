{
  "name": "@amplitude/plugin-experiment-react-native",
  "version": "1.0.0-beta.1",
  "description": "Amplitude Experiment plugin for React Native Analytics",
  "keywords": [
    "analytics",
    "amplitude",
    "experiment",
    "react-native"
  ],
  "author": "Amplitude Inc",
  "homepage": "https://github.com/amplitude/Amplitude-TypeScript",
  "license": "MIT",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amplitude/Amplitude-TypeScript.git"
  },
  "bugs": {
    "url": "https://github.com/amplitude/Amplitude-TypeScript/issues"
  },
  "files": [
    "src",
    "lib",
    "!test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf node_modules lib coverage",
    "fix": "pnpm fix:eslint & pnpm fix:prettier",
    "fix:eslint": "eslint '{src,test}/**/*.ts' --fix",
    "fix:prettier": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "pnpm lint:eslint & pnpm lint:prettier",
    "lint:eslint": "eslint '{src,test}/**/*.ts'",
    "lint:prettier": "prettier --check \"{src,test}/**/*.ts\"",
    "test": "jest",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "version": "pnpm version-file && pnpm build",
    "version-file": "node -p \"'export const VERSION = \\'' + require('./package.json').version + '\\';'\" > src/version.ts"
  },
  "dependencies": {
    "@amplitude/analytics-core": "workspace:*",
    "@amplitude/experiment-react-native-client": "^1.8.0"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-builder-bob": "^0.20.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
