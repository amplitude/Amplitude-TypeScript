{
  "name": "@amplitude/amp-semantic",
  "version": "0.2.0-sr-bfcache-pageshow-snapshot.0",
  "description": "Shared package foundation for Amplitude semantic event capture",
  "license": "MIT",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "pnpm clean && pnpm build:es5 && pnpm build:esm",
    "build:es5": "tsc -p tsconfig.es5.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "test": "jest",
    "lint": "eslint '{src,test}/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "tslib": "^2.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amplitude/Amplitude-TypeScript.git"
  },
  "homepage": "https://github.com/amplitude/Amplitude-TypeScript",
  "devDependencies": {
    "rimraf": "^3.0.2"
  }
}
